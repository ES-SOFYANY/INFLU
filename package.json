{
  "name": "influ-ai",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.11.1",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n db,api,web -c blue,green,magenta \"npm run dev:db:wait\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:db": "docker compose up -d dynamodb-local",
    "dev:db:wait": "npm run dev:db && node -e \"setTimeout(()=>{},1500)\" && npm run db:create",
    "dev:api": "npm -w apps/api run start:dev",
    "dev:web": "npm -w apps/web run start",
    "db:create": "node scripts/db/create-tables.js",
    "db:reset": "node scripts/db/reset.js",
    "db:seed": "node scripts/db/seed.js",
    "e2e": "npm -w apps/web run e2e",
    "build": "npm-run-all build:shared-types build:api",
    "build:shared-types": "npm -w packages/shared-types run build",
    "build:api": "npm -w apps/api run build",
    "test": "npm -w apps/api run test",
    "test:api": "npm -w apps/api run test",
    "lint": "eslint . --max-warnings 999 --ext .ts",
    "lint:fix": "eslint . --fix --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "generate:shared-types": "bash scripts/generate-shared-types.sh",
    "openapi:export": "npm -w apps/api run openapi:export"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.3.0",
    "typescript": "~5.4.5"
  }
}
